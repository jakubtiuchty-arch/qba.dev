---
// Ścieżka nawigacji (okruszki): droga od strony głównej do bieżącej podstrony.
// Ostatni element (bez `href`) to bieżąca strona — nie jest linkiem, ma aria-current="page".
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Ścieżka nawigacji">
  <ol>
    {
      items.map((item) => (
        <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  /* Separator tylko wizualny: czytnik ekranu go pomija (pusty tekst alternatywny). */
  li + li::before {
    content: '/';
    content: '/' / '';
    color: var(--muted);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }
  [aria-current='page'] {
    color: var(--ink);
  }
</style>
