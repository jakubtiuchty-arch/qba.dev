---
import { nav, site } from '../data/site';

const current = Astro.url.pathname;
// „page” dla bieżącej podstrony, „true” dla działu, w którym jesteśmy (np. opis realizacji w „Realizacjach”).
const ariaCurrent = (href: string) =>
  current === href ? 'page' : href !== '/' && current.startsWith(href) ? 'true' : undefined;
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/">
      <span class="wordmark__brand">qba.dev</span>
      <span class="wordmark__name">Jakub Tiuchty<span class="visually-hidden"> – strona główna</span></span>
    </a>

    <a class="bar__phone" href={site.contact.phoneHref}>
      <span class="visually-hidden">Zadzwoń: </span>{site.contact.phone}
    </a>

    <button class="menu-toggle" type="button" popovertarget="menu" aria-controls="menu">
      Menu
    </button>

    <nav id="menu" class="menu" popover aria-label="Główne menu">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={ariaCurrent(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
      <button class="menu__close" type="button" popovertarget="menu" popovertargetaction="hide">
        Zamknij menu
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .wordmark {
    display: inline-flex;
    flex-direction: column;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.15;
    padding-block: 0.4rem;
  }
  .wordmark__brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
  }
  .wordmark__name {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .bar__phone {
    margin-left: auto;
    font-weight: 700;
    white-space: nowrap;
    padding-block: 0.6rem;
  }

  .menu-toggle {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* Telefon: menu jako popover (działa bez JavaScriptu, Esc i klik obok zamykają). */
  .menu {
    margin: 0;
    inset: 0 0 auto auto;
    width: min(100%, 22rem);
    height: 100dvh;
    max-height: none;
    padding: 1.25rem;
    border: 0;
    border-left: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    flex-direction: column;
    gap: 1rem;
  }
  .menu:popover-open { display: flex; }
  .menu::backdrop { background: oklch(0.2 0.02 255 / 0.45); }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .menu li a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--step-1);
    text-decoration: none;
  }
  .menu a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .menu__close {
    order: -1;
    align-self: flex-end;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* Komputer: to samo menu wyświetlone w linii, przycisk znika. */
  @media (min-width: 52rem) {
    .menu-toggle,
    .menu__close { display: none; }

    .menu,
    .menu:popover-open {
      display: flex;
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      padding: 0;
      border: 0;
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
      background: transparent;
      overflow: visible;
    }
    .menu ul { flex-direction: row; gap: 1.5rem; }
    .menu li a {
      padding: 0.5rem 0;
      border: 0;
      font-size: 1rem;
    }
    .menu li a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
    .bar__phone { order: 3; margin-left: 0; font-size: 1rem; }
    .menu { margin-left: auto; }
  }
</style>
